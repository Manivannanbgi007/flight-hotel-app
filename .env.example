# ---------------------------------------------------------------------------
# Copy this file to ".env" and change the values. NEVER commit ".env".
# These defaults are for LOCAL DEVELOPMENT ONLY.
#
# Used by docker compose AND by services started with "mvn spring-boot:run"
# (each service imports ../../.env), so only put secrets and settings here,
# never container host names.
# ---------------------------------------------------------------------------

# --- MySQL -------------------------------------------------------------------
# Port on your PC where the Docker MySQL is published (3307 avoids clashing with a local MySQL on 3306).
MYSQL_HOST_PORT=3307
# Port that services started from PowerShell (mvn spring-boot:run) use to reach that MySQL.
DB_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
# One user per service database (database-per-service rule)
IDENTITY_DB_PASSWORD=change-me-identity
HOTEL_DB_PASSWORD=change-me-hotel
FLIGHT_DB_PASSWORD=change-me-flight
BOOKING_DB_PASSWORD=change-me-booking
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification
REPORTING_DB_PASSWORD=change-me-reporting
# Used only by Debezium (binlog reader)
DEBEZIUM_DB_PASSWORD=change-me-debezium

# --- Security ----------------------------------------------------------------
# Issuer name written into and checked on every JWT
JWT_ISSUER=flight-hotel-identity
# Allowed browser origins for CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 32-byte base64 key used to encrypt passport numbers (generate: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=

# Local development only: creates admin@, customer@, manager@ and support@flighthotel.local (one per role),
# all with DEMO_USER_PASSWORD (10-64 characters, letters and digits). Never enable this in production.
DEMO_USERS_ENABLED=false
DEMO_USER_PASSWORD=
# Phase 8: signs newsletter unsubscribe links (any long random text; empty = a fixed development value).
NEWSLETTER_SECRET=
# Local development only: seeds the dev.* accounts (admin, two customers, two hotel managers, support) and realistic
# hotels, bookings, payments, tickets and notifications for them. Documented in docs/DEVELOPMENT_TEST_ACCOUNTS.md.
# Never enable this in production (it also refuses to run in the prod profile).
DEV_SEED_ENABLED=false

# --- Payments (Phase 5) ------------------------------------------------------
# demo | razorpay. "demo" needs no account: the payment page shows a labelled Pay / Fail demo panel (never in production).
# For Razorpay test mode follow PAYMENT_INTEGRATION.md section 9. The secrets below stay in your local .env only.
PAYMENT_PROVIDER=demo
# The DEMO provider and its /api/payments/demo/* endpoints. Must be false in production.
PAYMENT_DEMO_ENABLED=true
# Signs the DEMO checkout callback. Any value locally; irrelevant when the DEMO provider is off.
PAYMENT_DEMO_SECRET=demo-only-secret-never-used-in-production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# Locally all emails go to Mailpit (http://localhost:8025); host/port are set in docker-compose.yml.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@flighthotel.local

# --- Frontend ----------------------------------------------------------------
# Public URL of the web app (used in email links)
APP_PUBLIC_URL=http://localhost:3000

# --- AI assistant (Phase 11) -------------------------------------------------
# See AI_ASSISTANT.md. The assistant runs a local model on Ollama (CPU only); it needs about 5.5 GB more memory.
# Shared secret between mcp-client-service and mcp-server-service (any long random text, at least 32 characters):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
MCP_SERVER_API_KEY=
# Where Ollama runs. Not set = the "ollama" container (Docker) or http://localhost:11434 (mvn spring-boot:run).
# Only set it for an Ollama outside Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# The model (chosen by the evaluation in AI_ASSISTANT.md). ollama-init pulls it on "docker compose up".
ASSISTANT_CHAT_MODEL=granite4:tiny-h
# Context window in tokens (system prompt + tools + 20 messages + tool results). Larger = more memory.
ASSISTANT_NUM_CTX=8192
# 0 = always the same wording; the assistant answers from data, so keep it low.
ASSISTANT_TEMPERATURE=0.2
# How long the model stays in memory after the last question (loading it again takes 5-15 s).
ASSISTANT_KEEP_ALIVE=30m
# Questions answered at the same time by Ollama (each needs its own context memory); others wait in a queue.
ASSISTANT_NUM_PARALLEL=1
# Memory limit of the Ollama container (model + context). See AI_ASSISTANT.md "Memory".
OLLAMA_MEM_LIMIT=6g
# Optional voice (docker compose --profile voice up -d). Empty URL = the "speaches" container in Docker; when it is
# not running, the browser's own speech APIs are used.
ASSISTANT_STT_URL=
ASSISTANT_STT_MODEL=Systran/faster-whisper-small
ASSISTANT_TTS_URL=
ASSISTANT_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
ASSISTANT_TTS_VOICE=af_heart
