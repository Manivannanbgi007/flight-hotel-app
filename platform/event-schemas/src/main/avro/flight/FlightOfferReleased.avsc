{
  "type": "record", "name": "FlightOfferReleased", "namespace": "com.flighthotel.events.flight",
  "doc": "Held seats went back on sale: EXPIRED (not paid in time) or BOOKING_FAILED / BOOKING_EXPIRED (on booking-service's request).",
  "fields": [
    { "name": "bookingId", "type": "string" },
    { "name": "holdId", "type": "string" },
    { "name": "reason", "type": "string" },
    { "name": "releasedAt", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
